# Copy to .env for make serve / make serve-hono / make serve-laya, then fill locally.
# This file contains no working credentials. Empty keys fail startup validation.
# Keep .env owner-readable only; never put real values in this template.
ONE_SYSTEM_API_KEY=''
LOCAL_API_KEY=''
TYPESAFE_API_KEY=''

ONE_SYSTEM_ADDR='127.0.0.1:8090'
# This registry serves automatic model routing-demo; choose other configs in README.
ONE_SYSTEM_CONFIG='backends.json'

# Optional local adapter. Serve targets load these from .env.
# Leave LAYA_RUNTIME commented to select it with a shell prefix.
# PyTorch CPU is the default; mlx requires Apple Silicon and setup-laya-mlx.
# LAYA_RUNTIME='torch'
# LAYA_MODEL_PATH='/absolute/path/to/existing/checkpoint'
# LAYA_ADDR='127.0.0.1:8091'
# LAYA_THREADS='4'

# Optional private registry: store it under the ignored .local/ directory.
# ONE_SYSTEM_CONFIG='.local/backends.json'
# Every registry needs a top-level name matching ^[A-Za-z0-9_-]+$, distinct from backend IDs.
# Clients use that exact name as model for automatic routing; there is no default alias.
# Keep api_key_env references in registries; never embed credential values.

# Optional decision cache (off without storage; MODE=off overrides storage).
# ONE_SYSTEM_CACHE_PATH='.local/decisions/cache.sqlite'
# ONE_SYSTEM_CACHE_EPOCH='deployment-v1'
# ONE_SYSTEM_CACHE_MODE='readwrite'
# ONE_SYSTEM_CACHE_NAMESPACE='default'
# ONE_SYSTEM_CACHE_TTL='1h'
# ONE_SYSTEM_CACHE_MAX_BYTES='67108864'

# Optional sensitive request/response history, independent of cache eviction.
# Off without storage. Use a DIFFERENT file from ONE_SYSTEM_CACHE_PATH.
# ONE_SYSTEM_LOG_PATH='.local/history/exchanges.sqlite'
# ONE_SYSTEM_LOG_MODE='record'
